# NEXUS OMEGA - Environment Variables Template
# Copy this file to .env and fill in your values

# ===== Server Configuration =====
PORT=8000
HOST=0.0.0.0

# Base directory for data, artifacts, and state
# Defaults to ./data in the current directory
NEXUS_BASE=./data

# ===== LLM Provider (Optional - enables AI reasoning) =====
# OpenAI API
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative: Use a different OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.your-provider.com/v1

# ===== GitHub Auto-Deployment (Optional) =====
# GitHub Personal Access Token for private repos or CI
AGENTS_DEPLOY_KEY=ghp_your_github_token
AGENTS_REPO_URL=https://github.com/youruser/Agents.git
AGENTS_BRANCH=main

# Webhook secret to verify GitHub payloads
AGENTS_WEBHOOK_SECRET=your-webhook-secret

# Webhook server port (default: 8443)
AGENTS_WEBHOOK_PORT=8443

# ===== Telegram Bot (Optional) =====
# Get your bot token from @BotFather
TG_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=your_chat_id_here

# ===== Optional: External Backend Proxy =====
# BACKEND_URL=http://localhost:8000

# ===== Notes =====
# - All keys are optional; app runs in limited mode without them
# - LLM keys enable AI reasoning and structured responses
# - GitHub keys enable auto-deployment from private repos
# - Telegram keys enable bot commands
# - Run: python -m playwright install chromium