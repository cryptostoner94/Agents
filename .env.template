# AGENTS v2 Environment Variables

# Data Directory (optional, defaults to ./data)
AGENTS_DATA_DIR=./data

# Server Port (optional, defaults to 8000)
PORT=8000

# ===== LLM Providers (add at least one) =====

# OpenRouter (recommended - access to multiple models)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Alternative: OpenAI Direct
OPENAI_API_KEY=sk-your-key-here

# Grok (x.ai)
GROK_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# HuggingFace
HUGGINGFACE_API_KEY=

# Fireworks AI
FIREWORKS_API_KEY=

# ===== Optional Services =====

# Telegram Bot (optional)
TG_TOKEN=
